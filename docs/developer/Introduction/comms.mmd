        subgraph Virtual interfaces
            ISerialPort
        end
        subgraph Interface implementations
            PCIE_CSR_Pipe
            FTDI_SerialPort
            FX3_SerialPort
        end
        subgraph Communication library ports
            LimePCIe
            FT601
            FX3
        end
